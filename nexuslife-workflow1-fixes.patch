--- /dev/null
+++ b/templates/phase-03/src/lib/provision.ts
@@ -0,0 +1,71 @@
+import "server-only"
+import { Prisma } from "@prisma/client"
+import { prisma } from "@/lib/prisma"
+
+export type AuthIdentity = {
+  /** Supabase Auth UUID, already validated server-side via supabase.auth.getUser(). */
+  id: string
+  email: string
+  name?: string | null
+  emailConfirmedAt?: string | null
+}
+
+export type ProvisionResult =
+  | { ok: true; userId: string; workspaceId: string }
+  | { ok: false; reason: "EMAIL_ALREADY_EXISTS" | "FAILED" }
+
+/**
+ * Idempotently create the internal User + default Workspace for a verified Supabase identity.
+ * Safe to call repeatedly: signup retries and first-request self-healing both use it.
+ * Never links an existing account by email alone (that needs a reviewed linking flow).
+ */
+export async function provisionUser(identity: AuthIdentity): Promise<ProvisionResult> {
+  const email = identity.email.trim().toLowerCase()
+
+  for (let attempt = 0; attempt < 2; attempt++) {
+    try {
+      return await prisma.$transaction(async (tx): Promise<ProvisionResult> => {
+        let user = await tx.user.findFirst({
+          where: { supabaseAuthId: identity.id, deletedAt: null },
+          select: { id: true },
+        })
+
+        if (!user) {
+          const sameEmail = await tx.user.findUnique({ where: { email }, select: { id: true } })
+          if (sameEmail) return { ok: false, reason: "EMAIL_ALREADY_EXISTS" }
+          user = await tx.user.create({
+            data: {
+              email,
+              supabaseAuthId: identity.id,
+              passwordHash: null,
+              name: identity.name ?? null,
+              emailVerified: Boolean(identity.emailConfirmedAt),
+            },
+            select: { id: true },
+          })
+        }
+
+        let workspace = await tx.workspace.findFirst({
+          where: { ownerId: user.id, deletedAt: null },
+          orderBy: { createdAt: "asc" },
+          select: { id: true },
+        })
+        if (!workspace) {
+          workspace = await tx.workspace.create({
+            data: { name: "Workspace pribadi", slug: `personal-${identity.id}`, ownerId: user.id },
+            select: { id: true },
+          })
+        }
+
+        return { ok: true, userId: user.id, workspaceId: workspace.id }
+      })
+    } catch (error) {
+      // A concurrent request may have provisioned the same identity; re-read once.
+      const isUniqueConflict = error instanceof Prisma.PrismaClientKnownRequestError && error.code === "P2002"
+      if (isUniqueConflict && attempt === 0) continue
+      console.error("User provisioning failed.")
+      return { ok: false, reason: "FAILED" }
+    }
+  }
+  return { ok: false, reason: "FAILED" }
+}
