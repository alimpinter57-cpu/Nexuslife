@@ -0,0 +1,27 @@
+const DEFAULT_TIME_ZONE = "Asia/Jakarta"
+
+function resolveTimeZone(): string {
+  const configured = process.env.NEXUSLIFE_TIMEZONE?.trim() || DEFAULT_TIME_ZONE
+  try {
+    new Intl.DateTimeFormat("en-CA", { timeZone: configured })
+    return configured
+  } catch {
+    return DEFAULT_TIME_ZONE
+  }
+}
+
+/**
+ * Calendar day in the app time zone (default Asia/Jakarta, override with NEXUSLIFE_TIMEZONE),
+ * stored as UTC midnight of that local date so HabitLog's (habitId, date) unique key stays stable.
+ * UTC-based days would roll over at 07:00 WIB and credit early-morning habits to the previous day.
+ */
+export function habitDay(now: Date = new Date()): Date {
+  const parts = new Intl.DateTimeFormat("en-CA", {
+    timeZone: resolveTimeZone(),
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(now)
+  const part = (type: string) => Number(parts.find((p) => p.type === type)?.value)
+  return new Date(Date.UTC(part("year"), part("month") - 1, part("day")))
+}
