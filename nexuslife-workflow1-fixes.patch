diff --git a/.github/workflows/deploy-prisma-migrations.yml b/.github/workflows/deploy-prisma-migrations.yml
new file mode 100644
index 0000000..158fa10
--- /dev/null
+++ b/.github/workflows/deploy-prisma-migrations.yml
@@ -0,0 +1,64 @@
+name: Deploy Prisma migrations to Supabase (manual, guarded)
+
+# Applies ALL pending migrations in prisma/migrations to the database behind the
+# DATABASE_URL / DIRECT_URL secrets. Review the migration files and take a backup first.
+# Tip: add required reviewers to the "supabase-database" GitHub Environment so this
+# job waits for a second approval before it can touch the database.
+
+on:
+  workflow_dispatch:
+    inputs:
+      confirm:
+        description: "Type APPLY-MIGRATIONS to apply every pending migration to the live database"
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+concurrency:
+  group: prisma-migrate-deploy
+  cancel-in-progress: false
+
+jobs:
+  deploy-migrations:
+    if: ${{ inputs.confirm == 'APPLY-MIGRATIONS' }}
+    runs-on: ubuntu-latest
+    environment: supabase-database
+    env:
+      DATABASE_URL: ${{ secrets.DATABASE_URL }}
+      DIRECT_URL: ${{ secrets.DIRECT_URL }}
+    steps:
+      - name: Checkout migration branch
+        uses: actions/checkout@v4
+        with:
+          ref: work/blueprint-phase-03
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: 20
+      - name: Verify required secrets exist without printing them
+        shell: bash
+        run: |
+          if [ -z "$DATABASE_URL" ] || [ -z "$DIRECT_URL" ]; then
+            echo "Missing DATABASE_URL or DIRECT_URL repository Actions secret."
+            exit 1
+          fi
+          echo "Required database secrets are present."
+      - name: Verify migration files exist
+        shell: bash
+        run: |
+          set -euo pipefail
+          test -s prisma/migrations/migration_lock.toml
+          count=0
+          for dir in prisma/migrations/*/; do
+            test -s "${dir}migration.sql"
+            count=$((count + 1))
+          done
+          echo "Found $count migration folders with non-empty migration.sql."
+      - name: Show migration state BEFORE applying (read-only; exit code ignored)
+        run: npx --yes prisma@6 migrate status --schema prisma/schema.prisma || true
+      - name: Apply committed migrations
+        run: npx --yes prisma@6 migrate deploy --schema prisma/schema.prisma
+      - name: Verify migration status AFTER applying
+        run: npx --yes prisma@6 migrate status --schema prisma/schema.prisma
