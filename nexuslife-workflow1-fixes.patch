diff --git a/prisma/migrations/0005_harden_migration_ledger_and_default_privileges/migration.sql b/prisma/migrations/0005_harden_migration_ledger_and_default_privileges/migration.sql
new file mode 100644
index 0000000..d5064cf
--- /dev/null
+++ b/prisma/migrations/0005_harden_migration_ledger_and_default_privileges/migration.sql
@@ -0,0 +1,42 @@
+-- NexusLife Phase 03 security boundary, part 2 (forward-only; review before applying).
+-- 0004 hardened the 16 application tables. This migration closes two remaining gaps:
+--   1. Prisma's own ledger (public."_prisma_migrations") is created in `public` and can
+--      inherit Supabase's default grants to anon/authenticated.
+--   2. Tables created by FUTURE migrations would inherit those default grants again.
+-- No policies are created: direct browser access stays denied until a reviewed client API exists.
+-- Role checks make this safe on plain PostgreSQL (local/CI), where anon/authenticated do not exist.
+-- ALTER DEFAULT PRIVILEGES affects only objects later created by the role running this migration
+-- (normally `postgres` on Supabase). Verify with the CI audit's DEFAULT_PRIVILEGE section.
+
+BEGIN;
+
+DO $$
+DECLARE
+  browser_role text;
+BEGIN
+  IF to_regclass('public."_prisma_migrations"') IS NOT NULL THEN
+    EXECUTE 'REVOKE ALL PRIVILEGES ON TABLE public."_prisma_migrations" FROM PUBLIC';
+    FOREACH browser_role IN ARRAY ARRAY['anon', 'authenticated'] LOOP
+      IF EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = browser_role) THEN
+        EXECUTE format('REVOKE ALL PRIVILEGES ON TABLE public."_prisma_migrations" FROM %I', browser_role);
+      END IF;
+    END LOOP;
+    EXECUTE 'ALTER TABLE public."_prisma_migrations" ENABLE ROW LEVEL SECURITY';
+  END IF;
+END
+$$;
+
+DO $$
+DECLARE
+  browser_role text;
+BEGIN
+  FOREACH browser_role IN ARRAY ARRAY['anon', 'authenticated'] LOOP
+    IF EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = browser_role) THEN
+      EXECUTE format('ALTER DEFAULT PRIVILEGES IN SCHEMA public REVOKE ALL ON TABLES FROM %I', browser_role);
+      EXECUTE format('ALTER DEFAULT PRIVILEGES IN SCHEMA public REVOKE ALL ON SEQUENCES FROM %I', browser_role);
+    END IF;
+  END LOOP;
+END
+$$;
+
+COMMIT;
